#!/bin/sh
# Refuses a commit that DELETES something the catalog can't work without.
#
# Files in a git repo can't usefully be locked in Finder: git has to be able to
# rewrite them on a pull or a branch switch, and the scripts have to be able to
# rewrite catalog.json, product_descriptions.csv and catalog_images/ on every
# run. A locked file breaks both, loudly and confusingly.
#
# Deleting a file locally isn't the real danger anyway -- it's in the Trash, and
# git can restore it. The damage happens when a deletion gets COMMITTED and
# PUSHED: now it's gone from GitHub, and the next person to pull loses it too.
# That's the step this stops.
#
# To delete something on purpose:  git commit --no-verify

PROTECTED='^(catalog\.json|product_descriptions\.csv|build_[a-z_]+\.py|squarespace/|catalog_images/|SETUP\.md|setup\.(ps1|sh)|supabase_[a-z_]+\.sql)'
IMAGE_DELETE_LIMIT=25

# --no-renames: a renamed-away file counts as a deletion here. Renaming a
# protected folder (catalog_images -> "(emoji)catalog_images", 2026-10-20, done
# to color-code it on Windows) moves every file out of the paths the site
# reads, which breaks exactly like deleting them.
# Conflict markers inside a staged file mean a merge/stash conflict was
# "resolved" by committing the raw <<<<<<< ======= >>>>>>> lines. That has
# shipped twice (2026-10-19 merge, 2026-10-27 stash pop) and each time it
# made catalog.json invalid JSON and took the live catalog down. Blocked
# outright -- there is never a reason to commit these markers here.
for f in catalog.json product_descriptions.csv; do
  if git show ":$f" 2>/dev/null | grep -qE '^(<<<<<<<|=======$|>>>>>>>)'; then
    echo ""
    echo "  ✋ $f contains git conflict markers (<<<<<<< / ======= / >>>>>>>)."
    echo ""
    echo "  Do NOT commit this. Fix it in three steps:"
    echo "    1. Right-click $f in GitHub Desktop -> Discard changes"
    echo "    2. Pull origin"
    echo "    3. Re-run your add command (the script rebuilds the file in seconds)"
    echo ""
    exit 1
  fi
done

deleted=$(git diff --cached --name-only --diff-filter=D --no-renames | grep -E "$PROTECTED")
[ -z "$deleted" ] && exit 0

images=$(printf '%s\n' "$deleted" | grep -c '^catalog_images/')
others=$(printf '%s\n' "$deleted" | grep -v '^catalog_images/')

# Removing a discontinued colour's photos is routine; removing hundreds is not.
if [ -z "$others" ] && [ "$images" -le "$IMAGE_DELETE_LIMIT" ]; then
  exit 0
fi

echo ""
echo "  ✋ This commit DELETES files the catalog depends on."
echo ""
if [ -n "$others" ]; then
  printf '%s\n' "$others" | sed 's/^/      /'
fi
if [ "$images" -gt 0 ]; then
  echo "      ...and $images file(s) under catalog_images/"
fi
echo ""
echo "  If that wasn't deliberate, nothing is lost -- put them back with:"
echo "      git checkout HEAD -- ."
echo ""
echo "  If you really do mean to delete them, commit again from Terminal with:"
echo "      git commit --no-verify -m \"your message\""
echo ""
exit 1
